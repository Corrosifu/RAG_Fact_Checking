# Copy to .env — every variable is optional; defaults run on a small CPU-only machine.
RAGFC_DATA_DIR=data

# Leave the bibliography out of the index (rebuild it with `ragfc index` after changing this)
# RAGFC_DROP_REFERENCES=true

# Retrieval: "hashing" (no download) or "sentence-transformers" (needs [ml])
RAGFC_EMBEDDER=hashing
# RAGFC_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAGFC_RERANKER=cross-encoder

# Generation: "extractive" (no model) or "hf" (needs [ml])
RAGFC_GENERATOR=extractive
# RAGFC_GENERATOR_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Fact-checking verdicts: "none" or "nli" (needs [ml])
RAGFC_VERIFIER=none

# Only for gated HuggingFace models (e.g. meta-llama/*)
# HF_TOKEN=hf_xxx

# Streamlit UI -> API
BACKEND_URL=http://localhost:8000
